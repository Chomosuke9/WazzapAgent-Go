# Copy this file to .env and replace every placeholder. The binary loads .env
# from its working directory at startup. Process environment variables override
# values in this file; set WAZZAP_ENV_FILE externally to select another path.


ASSISTANT_NAME=Vivy

WAZZAP_DATA_DIR=./data
WAZZAP_HTTP_ADDRESS=127.0.0.1:8080
WAZZAP_LOG_LEVEL=info
# Log format: json, text, or compact (compact format: HH:MM:SS LEVEL [chat_name] message key=value)
WAZZAP_LOG_FORMAT=compact
WAZZAP_SHUTDOWN_TIMEOUT=30s

# Tenant/account UUIDs are generated once and reused from
# <WAZZAP_DATA_DIR>/runtime-identity.json.

# Provider addresses are configuration secrets and are never printed normally.
# Direct user: E.164 digits without '+', followed by @s.whatsapp.net.
# Group: its WhatsApp JID ending in @g.us.
# Wildcards: * allows all private/group chats, *@lid all private chats, and *@g.us all groups.
WAZZAP_OWNER_JID=replace-with-owner-jid
WAZZAP_CHAT_ALLOWLIST=replace-with-test-chat-jid

# Use the full OpenAI-compatible chat-completions endpoint.
WAZZAP_LLM_ENDPOINT=https://provider.example/v1/chat/completions
WAZZAP_LLM_API_KEY=replace-with-secret
WAZZAP_LLM_MODEL=replace-with-model
# Optional resilience provider. It must expose the same model name and
# OpenAI-compatible chat-completions contract as WAZZAP_LLM_MODEL.
# WAZZAP_LLM_FALLBACK_ENDPOINT=https://backup-provider.example/v1/chat/completions
# WAZZAP_LLM_FALLBACK_API_KEY=replace-with-backup-secret
WAZZAP_LLM_PROVIDER_ID=openai-compatible
WAZZAP_LLM_TIMEOUT=60s
WAZZAP_LLM_CONCURRENCY=4
WAZZAP_MAX_OUTPUT_TOKENS=8192
WAZZAP_MAX_RESPONSE_BYTES=16384

# Optional LangSmith tracing for OpenAI-compatible model calls. Leave this
# commented or unset to keep tracing disabled.
# LANGSMITH_API_KEY=replace-with-langsmith-api-key

# Optional TypeSafe key for the Smart group trigger (/trigger smart on). When a
# chat turns it on, group messages that match no other trigger are sent to
# api.typesafe.ai to judge whether they are meant for the bot.
# TYPESAFE_API_KEY=replace-with-typesafe-api-key
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest

# Optional direct-invoke endpoint: makes the bot send a message first in a chat
# it already knows. GET or POST /post?q=<prompt>&jid=<chat jid or phone number>
# with the key in X-Api-Key, "Authorization: Bearer", or &key=. It answers
# 202 at once and the turn runs in the background; a model call that hits a
# rate limit or timeout is retried for up to 10 minutes. Off unless a key is
# set. It can make the bot say anything: keep it on loopback or behind a
# firewall or reverse proxy.
# DIRECT_INVOKE_API_KEY=replace-with-a-long-random-secret
# DIRECT_INVOKE_ADDRESS=127.0.0.1:8090

# Optional WazzapSubAgents sub-agent. With a URL set, chats switched on with
# /subagent on (owner only) get the execute_subtask tool: the Agent hands tasks
# it cannot do alone (files, code, the web) to the service, which calls back on
# the webhook with progress, queue position and the final report and files.
# Calling execute_subtask while a task runs steers it; the turn that delivers a
# result may start a correction. Use the same SUBAGENT_API_TOKEN and
# SUBAGENT_WEBHOOK_TOKEN values in WazzapSubAgents. A service in Docker reaches
# this machine through SUBAGENT_WEBHOOK_URL, for example
# http://host.docker.internal:8081/subagent/callback; a webhook address beyond
# loopback (such as 0.0.0.0:8081) requires SUBAGENT_WEBHOOK_TOKEN.
#
# SUBAGENT_BACKEND=metaai uses Meta AI instead, from the bot's own WhatsApp
# account: no URL or webhook is needed. Meta AI only takes images (and text)
# and only answers with text and images, and the Agent is told so: it uses
# the sub-agent to generate and edit images, to look at images and to search
# the internet, never for documents, code or files. Tasks run one at a time
# across all chats.
# SUBAGENT_BACKEND=service
# SUBAGENT_URL=http://localhost:5000
# SUBAGENT_API_TOKEN=replace-with-a-long-random-secret
# SUBAGENT_WEBHOOK_ADDRESS=127.0.0.1:8081
# SUBAGENT_WEBHOOK_URL=http://localhost:8081/subagent/callback
# SUBAGENT_WEBHOOK_TOKEN=replace-with-another-long-random-secret
# Sub-agent switch of chats nobody set with /subagent (also: /subagent default on|off).
# SUBAGENT_ENABLED_DEFAULT=false
# A task that sends nothing (no progress, no queue update) for this long is
# given up; SUBAGENT_MAX_WAIT bounds a task's whole run.
# SUBAGENT_WAIT_TIMEOUT=15m
# SUBAGENT_MAX_WAIT=2h

WAZZAP_BASE_PROMPT=Jawab pesan pengguna dengan ringkas dan akurat.
WAZZAP_POLICY_ID=part1-chat-gate.v1
WAZZAP_POLICY_REVISION=1

WAZZAP_INBOUND_QUEUE=512
WAZZAP_INBOUND_WORKERS=4
WAZZAP_MESSAGE_DEBOUNCE=350ms
WAZZAP_MESSAGE_BURST_CAP=8
# Wait this long for a group to go quiet before the smart trigger judges its
# newest message, so a burst costs one judgment. Empty judges every message.
WAZZAP_SMART_TRIGGER_DEBOUNCE=
WAZZAP_HISTORY_WINDOW=20
WAZZAP_MAX_CONTEXT_BYTES=65536
WAZZAP_HISTORY_KEEP_LATEST=256
WAZZAP_HISTORY_MAX_AGE=720h
WAZZAP_CONNECT_TIMEOUT=90s
WAZZAP_SEND_TIMEOUT=30s
