# Copy this file to .env and replace every placeholder. The binary loads .env
# from its working directory at startup. Process environment variables override
# values in this file; set DISCORDAGENT_ENV_FILE externally to select another path.


ASSISTANT_NAME=Vivy

DISCORDAGENT_DATA_DIR=./data
DISCORDAGENT_HTTP_ADDRESS=127.0.0.1:8080
DISCORDAGENT_LOG_LEVEL=info
# Log format: json, text, or compact (compact format: HH:MM:SS LEVEL [chat_name] message key=value)
DISCORDAGENT_LOG_FORMAT=compact
DISCORDAGENT_SHUTDOWN_TIMEOUT=30s

# Tenant/account UUIDs are generated once and reused from
# <DISCORDAGENT_DATA_DIR>/runtime-identity.json.

# The bot token from the Discord Developer Portal (Bot > Reset Token). Turn on
# the Message Content intent for the bot there. The CLI reads the token from
# here or the environment; the desktop and web apps link it on their Discord
# page instead and never read this value.
DISCORDAGENT_DISCORD_TOKEN=replace-with-bot-token

# Discord IDs are numbers: turn on Developer Mode in Discord's settings, then
# right-click a user, channel or server and choose "Copy ID".
# The owner is your own user ID.
# The allowlist takes channel, thread, server or user IDs, comma separated. A
# server admits all of its channels; a user admits direct messages with them.
# Wildcards: * allows every chat, server:* every server channel, and dm:* every
# direct message.
DISCORDAGENT_OWNER_ID=replace-with-your-user-id
DISCORDAGENT_CHAT_ALLOWLIST=replace-with-a-channel-or-server-id

# Use the full OpenAI-compatible chat-completions endpoint.
DISCORDAGENT_LLM_ENDPOINT=https://provider.example/v1/chat/completions
DISCORDAGENT_LLM_API_KEY=replace-with-secret
DISCORDAGENT_LLM_MODEL=replace-with-model
# Optional resilience provider. It must expose the same model name and
# OpenAI-compatible chat-completions contract as DISCORDAGENT_LLM_MODEL.
# DISCORDAGENT_LLM_FALLBACK_ENDPOINT=https://backup-provider.example/v1/chat/completions
# DISCORDAGENT_LLM_FALLBACK_API_KEY=replace-with-backup-secret
DISCORDAGENT_LLM_PROVIDER_ID=openai-compatible
DISCORDAGENT_LLM_TIMEOUT=60s
DISCORDAGENT_LLM_CONCURRENCY=4
DISCORDAGENT_MAX_OUTPUT_TOKENS=8192
DISCORDAGENT_MAX_RESPONSE_BYTES=16384

# Optional LangSmith tracing for OpenAI-compatible model calls. Leave this
# commented or unset to keep tracing disabled.
# LANGSMITH_API_KEY=replace-with-langsmith-api-key

# Optional TypeSafe key for the Smart channel trigger (/trigger smart on). When a
# chat turns it on, channel messages that match no other trigger are sent to
# api.typesafe.ai to judge whether they are meant for the bot.
# TYPESAFE_API_KEY=replace-with-typesafe-api-key
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest

DISCORDAGENT_BASE_PROMPT=Jawab pesan pengguna dengan ringkas dan akurat.
DISCORDAGENT_POLICY_ID=part1-chat-gate.v1
DISCORDAGENT_POLICY_REVISION=1

DISCORDAGENT_INBOUND_QUEUE=512
DISCORDAGENT_INBOUND_WORKERS=4
DISCORDAGENT_MESSAGE_DEBOUNCE=350ms
DISCORDAGENT_MESSAGE_BURST_CAP=8
DISCORDAGENT_HISTORY_WINDOW=20
DISCORDAGENT_MAX_CONTEXT_BYTES=65536
DISCORDAGENT_HISTORY_KEEP_LATEST=256
DISCORDAGENT_HISTORY_MAX_AGE=720h
DISCORDAGENT_CONNECT_TIMEOUT=90s
DISCORDAGENT_SEND_TIMEOUT=30s
