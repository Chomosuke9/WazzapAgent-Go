# The binary reads process environment variables; it does not load this file.
# Copy to .env, replace every placeholder, keep it private, then load it into
# the process as described in docs/rewrite/07-PART1-RUNBOOK.md.

WAZZAP_DATA_DIR=./data
WAZZAP_HTTP_ADDRESS=127.0.0.1:8080
WAZZAP_LOG_LEVEL=info
WAZZAP_LOG_FORMAT=json
WAZZAP_SHUTDOWN_TIMEOUT=30s

# Runtime and response kill switches. Pair with WhatsApp enabled and the agent
# disabled first. Enabling the agent also requires WhatsApp to be enabled.
WAZZAP_WHATSAPP_ENABLED=false
WAZZAP_AGENT_ENABLED=false
WAZZAP_PAIRING_OUTPUT=disabled

# Generate two different canonical lowercase UUIDs for one deployment.
WAZZAP_TENANT_ID=replace-with-tenant-uuid
WAZZAP_ACCOUNT_ID=replace-with-account-uuid

# Provider addresses are configuration secrets and are never printed normally.
# Direct user: E.164 digits without '+', followed by @s.whatsapp.net.
# Group: its WhatsApp JID ending in @g.us.
WAZZAP_OWNER_JID=replace-with-owner-jid
WAZZAP_CHAT_ALLOWLIST=replace-with-test-chat-jid

# Use the full OpenAI-compatible chat-completions endpoint.
WAZZAP_LLM_ENDPOINT=https://provider.example/v1/chat/completions
WAZZAP_LLM_API_KEY=replace-with-secret
WAZZAP_LLM_MODEL=replace-with-model
WAZZAP_LLM_PROVIDER_ID=openai-compatible
WAZZAP_LLM_TIMEOUT=60s
WAZZAP_LLM_CONCURRENCY=4
WAZZAP_MAX_OUTPUT_TOKENS=1024
WAZZAP_MAX_RESPONSE_BYTES=16384

WAZZAP_BASE_PROMPT=Jawab pesan pengguna dengan ringkas dan akurat.
WAZZAP_POLICY_ID=part1-chat-gate.v1
WAZZAP_POLICY_REVISION=1

WAZZAP_INBOUND_QUEUE=512
WAZZAP_INBOUND_WORKERS=4
WAZZAP_AGENT_MAX_LIVE=256
WAZZAP_AGENT_IDLE_TTL=15m
WAZZAP_AGENT_CONSTRUCTION_TIMEOUT=10s
WAZZAP_CONNECT_TIMEOUT=90s
WAZZAP_SEND_TIMEOUT=30s
