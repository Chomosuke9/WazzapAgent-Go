# Copy this file to embedded.env and replace every placeholder.
# The embedded.env file will be baked into the binary at build time.
# Process environment variables and .env files override embedded values.

ASSISTANT_NAME=Vivy

WAZZAP_DATA_DIR=./data
WAZZAP_HTTP_ADDRESS=127.0.0.1:8080
WAZZAP_LOG_LEVEL=info
WAZZAP_LOG_FORMAT=compact
WAZZAP_SHUTDOWN_TIMEOUT=30s

# Tenant/account UUIDs are generated once and reused from
# <WAZZAP_DATA_DIR>/runtime-identity.json.

# Provider addresses are configuration secrets and are never printed normally.
# Direct user: E.164 digits without '+', followed by @s.whatsapp.net.
# Group: its WhatsApp JID ending in @g.us.
WAZZAP_OWNER_JID=replace-with-owner-jid
WAZZAP_CHAT_ALLOWLIST=replace-with-test-chat-jid

# Use the full OpenAI-compatible chat-completions endpoint.
WAZZAP_LLM_ENDPOINT=https://provider.example/v1/chat/completions
WAZZAP_LLM_API_KEY=replace-with-secret
WAZZAP_LLM_MODEL=replace-with-model
# Optional resilience provider. It must expose the same model name and
# OpenAI-compatible chat-completions contract as WAZZAP_LLM_MODEL.
# WAZZAP_LLM_FALLBACK_ENDPOINT=https://backup-provider.example/v1/chat/completions
# WAZZAP_LLM_FALLBACK_API_KEY=replace-with-backup-secret
WAZZAP_LLM_PROVIDER_ID=openai-compatible
WAZZAP_LLM_TIMEOUT=60s
WAZZAP_LLM_CONCURRENCY=4
WAZZAP_MAX_OUTPUT_TOKENS=8192
WAZZAP_MAX_RESPONSE_BYTES=16384

# Optional LangSmith tracing for OpenAI-compatible model calls. Leave this
# commented or unset to keep tracing disabled.
# LANGSMITH_API_KEY=replace-with-langsmith-api-key

WAZZAP_BASE_PROMPT=Jawab pesan pengguna dengan ringkas dan akurat.
WAZZAP_POLICY_ID=part1-chat-gate.v1
WAZZAP_POLICY_REVISION=1

WAZZAP_INBOUND_QUEUE=512
WAZZAP_INBOUND_WORKERS=4
WAZZAP_COMMAND_QUEUE=128
WAZZAP_COMMAND_WORKERS=2
WAZZAP_AI_QUEUE=512
WAZZAP_AI_WORKERS=4
WAZZAP_MESSAGE_DEBOUNCE=350ms
WAZZAP_MESSAGE_BURST_CAP=8
WAZZAP_HISTORY_WINDOW=20
WAZZAP_MAX_CONTEXT_BYTES=65536
WAZZAP_HISTORY_KEEP_LATEST=256
WAZZAP_HISTORY_MAX_AGE=720h
WAZZAP_AGENT_MAX_LIVE=256
WAZZAP_AGENT_IDLE_TTL=15m
WAZZAP_AGENT_CONSTRUCTION_TIMEOUT=10s
WAZZAP_CONNECT_TIMEOUT=90s
WAZZAP_SEND_TIMEOUT=30s
